# A shell console. When it opens it runs "deno task dev": build into dist/, run the tests, write
# test_output/, then watch src/, public/ and tests/ and do it all again on every save.
# No Deno on this computer? Use the Node buttons: "npm install" once, then "npm run dev".
[session]
type = "shell"

[session.shell]
script = "deno task dev"

[[session.shortcut]]
label = "Deno: build, test, and watch for changes (press Ctrl+C first if it is already running)"
icon = "bs-arrow-repeat"
text = "deno task dev"

[[session.shortcut]]
label = "Deno: build into dist/ and test, once"
icon = "bs-hammer"
text = "deno task build"

[[session.shortcut]]
label = "Deno: run the tests, once"
icon = "bs-clipboard-check"
text = "deno task test"

[[session.shortcut]]
label = "Deno: lint - look for likely mistakes and bad habits"
icon = "bs-search"
text = "deno task lint"

[[session.shortcut]]
label = "Node: install the build tools into node_modules/ (first time only)"
icon = "bs-download"
text = "npm install"

[[session.shortcut]]
label = "Node: build, test, and watch for changes (press Ctrl+C first if it is already running)"
icon = "bs-arrow-repeat"
text = "npm run dev"

[[session.shortcut]]
label = "Node: build into dist/ and test, once"
icon = "bs-hammer"
text = "npm run build"

[[session.shortcut]]
label = "Node: run the tests, once"
icon = "bs-clipboard-check"
text = "npm test"
